#!/usr/bin/env python3
#
# nexora-store — graphical app store for NexoraOS
#
# Wraps pacman (official repos) and yay/paru (AUR) behind a friendly GUI.
# Features:
#   - Featured / popular apps on the home tab
#   - Categories (Games, Internet, Office, Dev, Media, System)
#   - Search (fuzzy, both repos + AUR via `yay -Ss`)
#   - One-click install / remove / update
#   - Progress bar + log panel
#   - "Update all" button
#
# Memory target: ~40 MB.

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib
import os
import re
import subprocess
import threading

CSS = b"""
.nexora-store { background-color: #0f2027; color: #e6e6e6; font-family: 'Ubuntu','Noto Sans',sans-serif; }
.nexora-store .header { font-size: 18px; font-weight: bold; color: #8be9fd; padding: 14px; }
.nexora-store .frame { background: rgba(255,255,255,0.03); border: 1px solid rgba(139,233,253,0.15); border-radius: 8px; padding: 8px; margin: 4px; }
.nexora-store .button { background: rgba(139,233,253,0.15); color: #e6e6e6; border: 1px solid rgba(139,233,253,0.30); border-radius: 4px; padding: 6px 12px; }
.nexora-store .button:hover { background: rgba(139,233,253,0.30); }
.nexora-store .primary { background: #8be9fd; color: #0f2027; font-weight: bold; }
.nexora-store .danger { background: rgba(255,99,99,0.20); border-color: rgba(255,99,99,0.45); }
.nexora-store entry, .nexora-store combobox { background: rgba(255,255,255,0.04); color: #fff; border-radius: 4px; }
.nexora-store .app-row { padding: 8px; border-bottom: 1px solid rgba(255,255,255,0.06); }
.nexora-store .app-name { font-weight: bold; color: #8be9fd; }
.nexora-store .app-desc { color: #aaa; font-size: 11px; }
.nexora-store .app-source { color: #6fc7e0; font-size: 10px; font-style: italic; }
"""

