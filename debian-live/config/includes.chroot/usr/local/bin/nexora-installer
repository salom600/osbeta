#!/usr/bin/env python3
#
# nexora-installer — NexoraOS graphical installer
#
# Debian-based installer that uses debootstrap + chroot to install NexoraOS
# to the target disk. No dependency on calamares or archinstall.
#
# Flow:
#   1. Welcome (requirements check)
#   2. Language + timezone
#   3. Disk selection + filesystem
#   4. User account
#   5. Summary
#   6. Install (debootstrap + chroot setup + GRUB install)
#   7. Reboot prompt
#
# Runs as root via pkexec/sudo.
#
# Memory: ~40 MB.

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib
import os
import sys
import subprocess
import threading
import json
import textwrap

CSS = b"""
.nexora-installer { background-color: #0f2027; color: #e6e6e6; font-family: 'Ubuntu','Noto Sans',sans-serif; }
.nexora-installer .header { font-size: 22px; font-weight: bold; color: #8be9fd; padding: 20px; }
.nexora-installer .sub { color: #b0b0b0; padding: 0 20px 14px 20px; font-size: 13px; }
.nexora-installer .frame { background: rgba(255,255,255,0.04); border: 1px solid rgba(139,233,253,0.18); border-radius: 8px; padding: 14px; margin: 14px; }
.nexora-installer .button { background: rgba(139,233,253,0.15); color: #e6e6e6; border: 1px solid rgba(139,233,253,0.30); border-radius: 4px; padding: 8px 16px; }
.nexora-installer .button:hover { background: rgba(139,233,253,0.30); }
.nexora-installer .primary { background: #8be9fd; color: #0f2027; font-weight: bold; }
.nexora-installer .primary:hover { background: #6fc7e0; }
.nexora-installer .danger { background: rgba(255,99,99,0.20); border-color: rgba(255,99,99,0.45); }
.nexora-installer entry, .nexora-installer combobox { background: rgba(255,255,255,0.04); color: #fff; border-radius: 4px; padding: 6px; }
.nexora-installer .log { background: rgba(0,0,0,0.30); color: #c0ffc0; font-family: 'JetBrains Mono','Monospace',monospace; font-size: 11px; padding: 8px; border-radius: 4px; }
"""


def log(msg):
    print(f"[nexora-installer] {msg}", flush=True)


def list_disks():
    """List available block devices using `lsblk`."""
    try:
        out = subprocess.check_output(
            ["lsblk", "-J", "-o", "NAME,SIZE,TYPE,MOUNTPOINTS,MODEL"],
            text=True,
        )
        data = json.loads(out)
        disks = []
        for dev in data.get("blockdevices", []):
            if dev.get("type") == "disk":
                name = dev["name"]
                size = dev.get("size", "?")
                model = dev.get("model", "") or ""
                disks.append((name, f"/dev/{name} ({size}) {model}".strip()))
        return disks
    except Exception as e:
        log(f"list_disks failed: {e}")
        return []


class Installer(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("NexoraOS Installer")
        self.set_default_size(760, 600)
        self.set_name("nexora-installer")

        self.config = {
            "language": "en_US",
            "timezone": "UTC",
            "disk": None,
            "filesystem": "btrfs",
            "username": "nexora",
            "password": "",
            "hostname": "nexora",
            "desktop": "nexora",
        }

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(outer)

        hdr = Gtk.Label(label="◆ Install NexoraOS 2026.1")
        hdr.get_style_context().add_class("header")
        outer.pack_start(hdr, False, False, 0)

        sub = Gtk.Label(label="Lightweight. Modern. Yours. — This wizard installs NexoraOS to your disk using debootstrap.")
        sub.get_style_context().add_class("sub")
        outer.pack_start(sub, False, False, 0)

        self.nb = Gtk.Notebook()
        self.nb.set_show_tabs(False)
        self.nb.set_show_border(False)
        outer.pack_start(self.nb, True, True, 0)

        self.pages = [
            ("welcome",   self._page_welcome),
            ("locale",    self._page_locale),
            ("disk",      self._page_disk),
            ("user",      self._page_user),
            ("summary",   self._page_summary),
            ("install",   self._page_install),
        ]
        for key, builder in self.pages:
            page = builder()
            self.nb.append_page(page, Gtk.Label(label=key))
        self.nb.set_current_page(0)

        nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        nav.set_border_width(10)
        outer.pack_start(nav, False, False, 0)

        self.back_btn = Gtk.Button(label="◀ Back")
        self.back_btn.connect("clicked", self.on_back)
        nav.pack_start(self.back_btn, False, False, 0)

        self.next_btn = Gtk.Button(label="Next ▶")
        self.next_btn.get_style_context().add_class("primary")
        self.next_btn.connect("clicked", self.on_next)
        nav.pack_end(self.next_btn, False, False, 0)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.show_all()
        self._update_nav()

    # ---------- Pages ----------

    def _page_welcome(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(20)
        info = Gtk.Label(label="""
<span size='large'><b>Welcome to the NexoraOS installer!</b></span>

This wizard will install NexoraOS 2026.1 on your computer using debootstrap.

<b>Before you begin:</b>
   • Back up any important data on the target disk
   • Make sure your computer is plugged in to power
   • Have at least 10 GB of free disk space

<b>What you'll get:</b>
   • NexoraDE — a lightweight desktop environment
   • Nexora Store — install apps from Debian repos
   • Full driver support for hardware from 2009+
   • BIOS or UEFI boot
   • Btrfs with snapshots (default) or ext4

Click <b>Next ▶</b> to continue.
""")
        info.set_use_markup(True)
        info.set_xalign(0)
        info.set_line_wrap(True)
        box.pack_start(info, True, True, 0)
        return box

    def _page_locale(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(20)

        lang_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        lang_row.pack_start(Gtk.Label(label="Language:"), False, False, 0)
        self.lang_cb = Gtk.ComboBoxText()
        for code, name in [
            ("en_US", "English (US)"),
            ("en_GB", "English (UK)"),
            ("ar_SA", "العربية"),
            ("fr_FR", "Français"),
            ("es_ES", "Español"),
            ("de_DE", "Deutsch"),
            ("it_IT", "Italiano"),
            ("pt_BR", "Português (Brasil)"),
            ("ru_RU", "Русский"),
            ("zh_CN", "中文 (简体)"),
            ("ja_JP", "日本語"),
            ("ko_KR", "한국어"),
            ("tr_TR", "Türkçe"),
        ]:
            self.lang_cb.append_text(f"{code} — {name}")
        self.lang_cb.set_active(0)
        self.lang_cb.connect("changed", lambda w: self.config.update({"language": w.get_active_text().split(" — ")[0]}))
        lang_row.pack_start(self.lang_cb, False, False, 0)
        box.pack_start(lang_row, False, False, 0)

        tz_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        tz_row.pack_start(Gtk.Label(label="Timezone:"), False, False, 0)
        self.tz_cb = Gtk.ComboBoxText()
        for tz in ["UTC", "Africa/Lagos", "Africa/Cairo", "Europe/London", "Europe/Paris", "Europe/Berlin", "America/New_York", "America/Los_Angeles", "Asia/Dubai", "Asia/Tokyo", "Asia/Shanghai"]:
            self.tz_cb.append_text(tz)
        self.tz_cb.set_active(0)
        self.tz_cb.connect("changed", lambda w: self.config.update({"timezone": w.get_active_text()}))
        tz_row.pack_start(self.tz_cb, False, False, 0)
        box.pack_start(tz_row, False, False, 0)

        return box

    def _page_disk(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(20)

        warn = Gtk.Label(label="⚠ <b>WARNING:</b> The selected disk will be ERASED. Back up any data first.")
        warn.set_use_markup(True)
        warn.set_xalign(0)
        box.pack_start(warn, False, False, 0)

        disk_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        disk_row.pack_start(Gtk.Label(label="Target disk:"), False, False, 0)
        self.disk_cb = Gtk.ComboBoxText()
        for name, desc in list_disks():
            self.disk_cb.append_text(desc)
        if self.disk_cb.get_active_text() is None and self.disk_cb.get_model().iter_n_children(None) > 0:
            self.disk_cb.set_active(0)
        self.disk_cb.connect("changed", self.on_disk_changed)
        disk_row.pack_start(self.disk_cb, True, True, 0)
        box.pack_start(disk_row, False, False, 0)

        fs_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        fs_row.pack_start(Gtk.Label(label="Filesystem:"), False, False, 0)
        self.fs_cb = Gtk.ComboBoxText()
        for fs in ["btrfs (recommended, snapshots)", "ext4 (stable, simple)", "xfs (high throughput)", "f2fs (flash-optimized)"]:
            self.fs_cb.append_text(fs)
        self.fs_cb.set_active(0)
        self.fs_cb.connect("changed", lambda w: self.config.update({"filesystem": w.get_active_text().split(" ")[0]}))
        fs_row.pack_start(self.fs_cb, False, False, 0)
        box.pack_start(fs_row, False, False, 0)

        return box

    def on_disk_changed(self, w):
        text = w.get_active_text() or ""
        parts = text.split(" ")
        if parts:
            self.config["disk"] = parts[0]

    def _page_user(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(20)

        u_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        u_row.pack_start(Gtk.Label(label="Username:"), False, False, 0)
        self.u_entry = Gtk.Entry()
        self.u_entry.set_text("nexora")
        self.u_entry.connect("changed", lambda w: self.config.update({"username": w.get_text()}))
        u_row.pack_start(self.u_entry, True, True, 0)
        box.pack_start(u_row, False, False, 0)

        p_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        p_row.pack_start(Gtk.Label(label="Password:"), False, False, 0)
        self.p_entry = Gtk.Entry(visibility=False)
        self.p_entry.connect("changed", lambda w: self.config.update({"password": w.get_text()}))
        p_row.pack_start(self.p_entry, True, True, 0)
        box.pack_start(p_row, False, False, 0)

        pc_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        pc_row.pack_start(Gtk.Label(label="Confirm:"), False, False, 0)
        self.pc_entry = Gtk.Entry(visibility=False)
        pc_row.pack_start(self.pc_entry, True, True, 0)
        box.pack_start(pc_row, False, False, 0)

        h_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        h_row.pack_start(Gtk.Label(label="Computer name:"), False, False, 0)
        self.h_entry = Gtk.Entry()
        self.h_entry.set_text("nexora")
        self.h_entry.connect("changed", lambda w: self.config.update({"hostname": w.get_text()}))
        h_row.pack_start(self.h_entry, True, True, 0)
        box.pack_start(h_row, False, False, 0)

        return box

    def _page_summary(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(20)

        c = self.config
        summary = f"""
<b>Ready to install NexoraOS 2026.1</b>

<b>Language:</b>     {c['language']}
<b>Timezone:</b>     {c['timezone']}
<b>Disk:</b>         {c.get('disk', '(none)')}
<b>Filesystem:</b>   {c['filesystem']}
<b>Username:</b>     {c['username']}
<b>Computer name:</b> {c['hostname']}
<b>Desktop:</b>      NexoraDE (default)
<b>Base:</b>         Debian 13 (Trixie) + custom Nexora kernel

<b>⚠ This will erase all data on the target disk.</b>

Click <b>Install</b> to begin.
"""
        lbl = Gtk.Label(label=summary)
        lbl.set_use_markup(True)
        lbl.set_xalign(0)
        box.pack_start(lbl, True, True, 0)
        return box

    def _page_install(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(20)

        self.progress = Gtk.ProgressBar()
        self.progress.set_text("Installing...")
        box.pack_start(self.progress, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        self.log_view = Gtk.TextView()
        self.log_view.set_editable(False)
        self.log_view.get_style_context().add_class("log")
        self.log_view.get_buffer().set_text("Ready to install.\n")
        scroll.add(self.log_view)
        box.pack_start(scroll, True, True, 0)
        return box

    # ---------- Navigation ----------

    def _update_nav(self):
        page = self.nb.get_current_page()
        self.back_btn.set_sensitive(page > 0 and page < len(self.pages) - 1)
        if page == len(self.pages) - 1:
            self.next_btn.set_label("Install")
            self.next_btn.get_style_context().add_class("primary")
        elif page == len(self.pages) - 2:
            self.next_btn.set_label("Install ▶")
        else:
            self.next_btn.set_label("Next ▶")

    def on_back(self, *_):
        cur = self.nb.get_current_page()
        if cur > 0:
            self.nb.set_current_page(cur - 1)
        self._update_nav()

    def on_next(self, *_):
        cur = self.nb.get_current_page()
        last = len(self.pages) - 1
        if cur < last:
            if cur == 3:  # user page
                p1 = self.p_entry.get_text()
                p2 = self.pc_entry.get_text()
                if not p1 or p1 != p2:
                    dlg = Gtk.MessageDialog(self, 0, Gtk.MessageType.ERROR, Gtk.ButtonsType.OK,
                                            "Passwords do not match or are empty.")
                    dlg.run(); dlg.destroy()
                    return
                if not self.config["username"].isidentifier():
                    dlg = Gtk.MessageDialog(self, 0, Gtk.MessageType.ERROR, Gtk.ButtonsType.OK,
                                            "Username must be a valid identifier.")
                    dlg.run(); dlg.destroy()
                    return
            if cur == 2:  # disk page
                if not self.config.get("disk"):
                    dlg = Gtk.MessageDialog(self, 0, Gtk.MessageType.ERROR, Gtk.ButtonsType.OK,
                                            "Please select a target disk.")
                    dlg.run(); dlg.destroy()
                    return

            self.nb.set_current_page(cur + 1)
            self._update_nav()

            if cur + 1 == last:
                self.next_btn.set_sensitive(False)
                self.back_btn.set_sensitive(False)
                threading.Thread(target=self._run_install, daemon=True).start()
        else:
            Gtk.main_quit()

    # ---------- Install ----------

    def _append_log(self, text):
        buf = self.log_view.get_buffer()
        end = buf.get_end_iter()
        buf.insert(end, text)
        if not text.endswith("\n"):
            buf.insert(buf.get_end_iter(), "\n")
        self.log_view.scroll_to_iter(buf.get_end_iter(), 0.0, False, 0.0, 0.0)

    def _set_progress(self, frac, text=None):
        self.progress.set_fraction(frac)
        if text:
            self.progress.set_text(text)

    def _run_install(self):
        """Run the actual install using debootstrap + chroot."""
        c = self.config
        try:
            script = self._build_install_script()
            with open("/tmp/nexora-install.sh", "w") as f:
                f.write(script)
            os.chmod("/tmp/nexora-install.sh", 0o755)

            # Stream output line-by-line to the log view
            GLib.idle_add(self._set_progress, 0.02, "Starting installation...")
            GLib.idle_add(self._append_log, "$ /tmp/nexora-install.sh\n")

            proc = subprocess.Popen(
                ["/tmp/nexora-install.sh"],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1,
            )
            for line in proc.stdout:
                GLib.idle_add(self._append_log, line)
            proc.wait()
            rc = proc.returncode
            if rc == 0:
                GLib.idle_add(self._append_log, "\n✓ Installation complete! You can reboot now.")
                GLib.idle_add(self._set_progress, 1.0, "Complete!")
                GLib.idle_add(self.next_btn.set_label, "Finish")
                GLib.idle_add(self.next_btn.set_sensitive, True)
            else:
                GLib.idle_add(self._append_log, f"\n✗ Installation failed with exit code {rc}")
                GLib.idle_add(self._set_progress, 0.0, "Failed")
                GLib.idle_add(self.next_btn.set_label, "Retry")
                GLib.idle_add(self.next_btn.set_sensitive, True)
        except Exception as e:
            GLib.idle_add(self._append_log, f"\n✗ Exception: {e}")
            GLib.idle_add(self.next_btn.set_sensitive, True)

    def _build_install_script(self):
        c = self.config
        disk = c["disk"]
        fs = c["filesystem"]
        return textwrap.dedent(f"""\
            #!/bin/bash
            set -euo pipefail

            # NexoraOS installation script (Debian-based via debootstrap)
            # Generated by nexora-installer

            DISK="{disk}"
            FS="{fs}"
            USERNAME="{c['username']}"
            PASSWORD="{c['password']}"
            HOSTNAME="{c['hostname']}"
            LANG_CODE="{c['language']}"
            TIMEZONE="{c['timezone']}"

            export DEBIAN_FRONTEND=noninteractive

            echo "==> Step 1/9: Partitioning $DISK"
            # GPT layout: 1 ESP (1 GB), 2 root (rest)
            sgdisk --zap-all "$DISK" || parted -s "$DISK" mklabel gpt
            sgdisk -n 1:0:+1G -t 1:ef00 -c 1:"EFI System" "$DISK"
            sgdisk -n 2:0:0   -t 2:8300 -c 2:"NexoraOS root" "$DISK"

            # Detect partition naming
            if [[ "$DISK" == *"nvme"* ]] || [[ "$DISK" == *"mmcblk"* ]]; then
                P1="${{DISK}}p1"
                P2="${{DISK}}p2"
            else
                P1="${{DISK}}1"
                P2="${{DISK}}2"
            fi

            echo "==> Step 2/9: Formatting partitions"
            mkfs.fat -F32 "$P1"
            case "$FS" in
              btrfs) mkfs.btrfs -f "$P2" ;;
              ext4)  mkfs.ext4 -F "$P2" ;;
              xfs)   mkfs.xfs -f "$P2" ;;
              f2fs)  mkfs.f2fs -f "$P2" ;;
            esac

            echo "==> Step 3/9: Mounting"
            mount "$P2" /mnt
            mkdir -p /mnt/boot/efi
            mount "$P1" /mnt/boot/efi

            echo "==> Step 4/9: Debootstrap (base system install — ~5-10 min)"
            debootstrap --arch=amd64 trixie /mnt http://deb.debian.org/debian

            echo "==> Step 5/9: Configuring base system in chroot"
            mount --bind /dev  /mnt/dev
            mount --bind /proc /mnt/proc
            mount --bind /sys  /mnt/sys
            mount --bind /run  /mnt/run 2>/dev/null || true

            chroot /mnt /bin/bash -ex <<'CHROOT'
            # Hostname
            echo "${HOSTNAME}" > /etc/hostname
            cat > /etc/hosts <<H
            127.0.0.1   localhost
            127.0.1.1   ${HOSTNAME}
            ::1         localhost ip6-localhost ip6-loopback
            H

            # Timezone
            ln -sf /usr/share/zoneinfo/${TIMEZONE} /etc/localtime

            # Locale
            sed -i "s/^# *${LANG_CODE}.UTF-8/${LANG_CODE}.UTF-8/" /etc/locale.gen
            locale-gen
            echo "LANG=${LANG_CODE}.UTF-8" > /etc/locale.conf

            # Apt sources — full trixie + updates + security
            cat > /etc/apt/sources.list <<SOURCES
            deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware
            deb http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware
            deb http://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware
            SOURCES

            apt-get update
            apt-get install -y --no-install-recommends \\
              linux-image-amd64 linux-headers-amd64 \\
              systemd systemd-sysv dbus \\
              network-manager wpasupplicant \\
              pipewire pipewire-pulse wireplumber \\
              xorg xserver-xorg xserver-xorg-video-all xserver-xorg-input-all \\
              openbox lightdm lightdm-gtk-greeter \\
              python3 python3-gi python3-psutil python3-dbus \\
              gtk3 libgtk-3-0 libnotify-bin notification-daemon \\
              pcmanfm lxterminal mousepad firefox-esr \\
              vim nano git sudo \\
              btrfs-progs e2fsprogs dosfstools \\
              grub-pc grub-efi-amd64 efibootmgr \\
              mesa-vulkan-drivers libgl1-mesa-dri \\
              intel-microcode amd64-microcode \\
              firmware-linux firmware-misc-nonfree \\
              papirus-icon-theme \\
              calamares

            # User
            useradd -m -G sudo,storage,power,video,audio,input,lp -s /bin/bash "${USERNAME}"
            echo "${USERNAME}:${PASSWORD}" | chpasswd
            echo "root:root" | chpasswd
            echo "${USERNAME} ALL=(ALL) ALL" > /etc/sudoers.d/010-${USERNAME}
            chmod 440 /etc/sudoers.d/010-${USERNAME}

            # Services
            systemctl enable NetworkManager
            systemctl enable lightdm
            systemctl enable systemd-timesyncd
            systemctl enable bluetooth 2>/dev/null || true
            systemctl enable udisks2 2>/dev/null || true
            systemctl enable polkit 2>/dev/null || true
            CHROOT

            echo "==> Step 6/9: Copying NexoraDE into target"
            cp -r /usr/local/bin/nexora-* /mnt/usr/local/bin/ 2>/dev/null || true
            cp -r /etc/skel/. /mnt/etc/skel/ 2>/dev/null || true
            mkdir -p /mnt/usr/share/xsessions
            cp /usr/share/xsessions/nexora.desktop /mnt/usr/share/xsessions/ 2>/dev/null || true

            # Enable LightDM autologin for the new user
            mkdir -p /mnt/etc/lightdm
            cat > /mnt/etc/lightdm/lightdm.conf <<LIGHTDM
            [Seat:*]
            greeter-session=lightdm-gtk-greeter
            user-session=nexora
            autologin-user=${USERNAME}
            autologin-session=nexora
            autologin-user-timeout=0
            LIGHTDM

            echo "==> Step 7/9: Generating fstab"
            # Use blkid + manual fstab (genfstab is arch-only)
            ROOT_UUID=$(blkid -s UUID -o value "$P2")
            EFI_UUID=$(blkid -s UUID -o value "$P1")
            cat > /mnt/etc/fstab <<FSTAB
            UUID=$ROOT_UUID  /           $FS    defaults   0 1
            UUID=$EFI_UUID   /boot/efi  vfat   umask=0077 0 2
            tmpfs             /tmp        tmpfs  defaults   0 0
            FSTAB
            echo "    -> /mnt/etc/fstab written (root UUID=$ROOT_UUID, efi UUID=$EFI_UUID)"

            echo "==> Step 8/9: Installing bootloader"
            # Detect UEFI vs BIOS by checking for /sys/firmware/efi
            if [ -d /sys/firmware/efi ]; then
                echo "    UEFI boot detected."
                chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=NexoraOS
            else
                echo "    BIOS boot detected."
                chroot /mnt grub-install "$DISK"
            fi
            chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg

            echo "==> Step 9/9: Cleanup + unmount"
            umount -R /mnt

            echo ""
            echo "✓ NexoraOS installed successfully!"
            echo "  Reboot to start using your new system."
        """)


def main():
    if os.geteuid() != 0:
        print("nexora-installer needs root. Re-launching via pkexec…")
        try:
            subprocess.execvp("pkexec", ["pkexec", sys.argv[0]] + sys.argv[1:])
        except Exception:
            subprocess.execvp("sudo", ["sudo", "-E", sys.argv[0]] + sys.argv[1:])
    win = Installer()
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
