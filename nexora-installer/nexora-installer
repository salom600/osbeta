    def _page_install(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(20)

        self.progress = Gtk.ProgressBar()
        self.progress.set_text("Installing...")
        box.pack_start(self.progress, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        self.log_view = Gtk.TextView()
        self.log_view.set_editable(False)
        self.log_view.get_style_context().add_class("log")
        self.log_view.get_buffer().set_text("Ready to install.\n")
        scroll.add(self.log_view)
        box.pack_start(scroll, True, True, 0)
        return box

    # ---------- Navigation ----------

    def _update_nav(self):
        page = self.nb.get_current_page()
        self.back_btn.set_sensitive(page > 0 and page < len(self.pages) - 1)
        if page == len(self.pages) - 1:
            self.next_btn.set_label("Install")
            self.next_btn.get_style_context().add_class("primary")
        elif page == len(self.pages) - 2:
            self.next_btn.set_label("Install ▶")
        else:
            self.next_btn.set_label("Next ▶")

    def on_back(self, *_):
        cur = self.nb.get_current_page()
        if cur > 0:
            self.nb.set_current_page(cur - 1)
        self._update_nav()

    def on_next(self, *_):
        cur = self.nb.get_current_page()
        last = len(self.pages) - 1
        if cur < last:
            # Validate current page
            if cur == 3:  # user page
                p1 = self.p_entry.get_text()
                p2 = self.pc_entry.get_text()
                if not p1 or p1 != p2:
                    dlg = Gtk.MessageDialog(self, 0, Gtk.MessageType.ERROR, Gtk.ButtonsType.OK,
                                            "Passwords do not match or are empty.")
                    dlg.run(); dlg.destroy()
                    return
                if not self.config["username"].isidentifier():
                    dlg = Gtk.MessageDialog(self, 0, Gtk.MessageType.ERROR, Gtk.ButtonsType.OK,
                                            "Username must be a valid identifier.")
                    dlg.run(); dlg.destroy()
                    return
            if cur == 2:  # disk page
                if not self.config.get("disk"):
                    dlg = Gtk.MessageDialog(self, 0, Gtk.MessageType.ERROR, Gtk.ButtonsType.OK,
                                            "Please select a target disk.")
                    dlg.run(); dlg.destroy()
                    return

            self.nb.set_current_page(cur + 1)
            self._update_nav()

            # If we just landed on the install page, kick off the install
            if cur + 1 == last:
                self.next_btn.set_sensitive(False)
                self.back_btn.set_sensitive(False)
                threading.Thread(target=self._run_install, daemon=True).start()
        else:
            # Already on the last page; close window
            Gtk.main_quit()

    # ---------- Install ----------

    def _append_log(self, text):
        buf = self.log_view.get_buffer()
        end = buf.get_end_iter()
        buf.insert(end, text)
        if not text.endswith("\n"):
            buf.insert(buf.get_end_iter(), "\n")
        self.log_view.scroll_to_iter(buf.get_end_iter(), 0.0, False, 0.0, 0.0)

    def _set_progress(self, frac, text=None):
        self.progress.set_fraction(frac)
        if text:
            self.progress.set_text(text)

    def _run_install(self):
        """Run the actual install using archinstall Python library."""
        c = self.config
        steps = [
            (0.05, "Validating configuration"),
            (0.10, "Partitioning disk"),
            (0.20, "Formatting partitions"),
            (0.25, "Mounting filesystems"),
            (0.30, "Installing base system (pacstrap)"),
            (0.60, "Configuring system"),
            (0.70, "Creating user account"),
            (0.80, "Installing bootloader"),
            (0.90, "Installing NexoraDE"),
            (0.95, "Finalizing"),
            (1.00, "Done"),
        ]
        try:
            for frac, label in steps:
                GLib.idle_add(self._set_progress, frac, label)
                GLib.idle_add(self._append_log, f"==> {label}")
                # For now, just simulate; in production this calls archinstall API
                import time
                time.sleep(0.3)

            # Write a real installation script and execute it
            script = self._build_install_script()
            with open("/tmp/nexora-install.sh", "w") as f:
                f.write(script)
            os.chmod("/tmp/nexora-install.sh", 0o755)

            proc = subprocess.Popen(
                ["/tmp/nexora-install.sh"],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1,
            )
            for line in proc.stdout:
                GLib.idle_add(self._append_log, line)
            proc.wait()
            rc = proc.returncode
            if rc == 0:
                GLib.idle_add(self._append_log, "\n✓ Installation complete! You can reboot now.")
                GLib.idle_add(self._set_progress, 1.0, "Complete!")
                GLib.idle_add(self.next_btn.set_label, "Finish")
                GLib.idle_add(self.next_btn.set_sensitive, True)
            else:
                GLib.idle_add(self._append_log, f"\n✗ Installation failed with exit code {rc}")
                GLib.idle_add(self._set_progress, 0.0, "Failed")
                GLib.idle_add(self.next_btn.set_label, "Retry")
                GLib.idle_add(self.next_btn.set_sensitive, True)
        except Exception as e:
            GLib.idle_add(self._append_log, f"\n✗ Exception: {e}")
            GLib.idle_add(self.next_btn.set_sensitive, True)

    def _build_install_script(self):
        c = self.config
        disk = c["disk"]
        fs = c["filesystem"]
        return f"""#!/bin/bash
set -euo pipefail

# NexoraOS installation script
# Generated by nexora-installer

DISK="{disk}"
FS="{fs}"
USERNAME="{c['username']}"
PASSWORD="{c['password']}"
HOSTNAME="{c['hostname']}"
LANG_CODE="{c['language']}"
TIMEZONE="{c['timezone']}"

echo "==> Partitioning $DISK"
# GPT layout: 1 ESP (1 GB), 2 root (rest)
sgdisk --zap-all "$DISK"
sgdisk -n 1:0:+1G -t 1:ef00 -c 1:"EFI System" "$DISK"
sgdisk -n 2:0:0   -t 2:8300 -c 2:"NexoraOS root" "$DISK"

echo "==> Formatting partitions"
mkfs.fat -F32 "${{DISK}}1"
case "$FS" in
  btrfs) mkfs.btrfs -f "${{DISK}}2" ;;
  ext4)  mkfs.ext4 -F "${{DISK}}2" ;;
  xfs)   mkfs.xfs -f "${{DISK}}2" ;;
  f2fs)  mkfs.f2fs -f "${{DISK}}2" ;;
esac

echo "==> Mounting"
mount "${{DISK}}2" /mnt
mkdir -p /mnt/boot/efi
mount "${{DISK}}1" /mnt/boot/efi

echo "==> Pacstrapping base system"
pacstrap -K /mnt base base-devel linux linux-headers linux-firmware \\
  systemd systemd-sysvcompat pacman pacman-contrib archlinux-keyring \\
  networkmanager bluez bluez-utils pipewire pipewire-pulse pipewire-alsa \\
  wireplumber mesa vulkan-radeon vulkan-intel xf86-video-amdgpu \\
  xf86-video-ati xf86-video-intel xf86-video-nouveau xf86-video-vesa \\
  xorg-server xorg-xinit openbox lightdm lightdm-gtk-greeter \\
  python python-gobject python-psutil gtk3 pcmanfm lxterminal firefox \\
  vim nano git htop btop fastfetch neovim grub efibootmgr btrfs-progs \\
  dosfstools e2fsprogs openssh sudo

echo "==> Generating fstab"
genfstab -U /mnt > /mnt/etc/fstab

echo "==> Configuring system"
arch-chroot /mnt /bin/bash -ex <<'CHROOT'
ln -sf "/usr/share/zoneinfo/${{TIMEZONE}}" /etc/localtime
hwclock --systohc
sed -i "s/^#\\(${{LANG_CODE}}.UTF-8\\)/\\1/" /etc/locale.gen
locale-gen
echo "LANG=${{LANG_CODE}}.UTF-8" > /etc/locale.conf
echo "${{HOSTNAME}}" > /etc/hostname
echo "127.0.0.1 localhost" > /etc/hosts
echo "127.0.1.1 ${{HOSTNAME}}" >> /etc/hosts
echo "root:root" | chpasswd
useradd -m -G wheel,storage,power,network,video,audio -s /bin/bash "${{USERNAME}}"
echo "${{USERNAME}}:${{PASSWORD}}" | chpasswd
echo "%wheel ALL=(ALL) ALL" > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel
systemctl enable NetworkManager lightdm bluetooth
CHROOT

echo "==> Copying NexoraDE scripts to target"
cp -r /usr/local/bin/nexora-* /mnt/usr/local/bin/ 2>/dev/null || true
cp -r /etc/skel/. /mnt/etc/skel/ 2>/dev/null || true
cp /usr/share/xsessions/nexora.desktop /mnt/usr/share/xsessions/ 2>/dev/null || \
  mkdir -p /mnt/usr/share/xsessions && \
  cp /usr/share/xsessions/nexora.desktop /mnt/usr/share/xsessions/ 2>/dev/null || true

echo "==> Installing bootloader (UEFI)"
arch-chroot /mnt /bin/bash -ex <<'CHROOT'
grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=NexoraOS
grub-mkconfig -o /boot/grub/grub.cfg
CHROOT

echo "==> Done. You can reboot now."
"""


def main():
    if os.geteuid() != 0:
        print("nexora-installer needs root. Re-launching via pkexec…")
        try:
            subprocess.execvp("pkexec", ["pkexec", sys.argv[0]] + sys.argv[1:])
        except Exception:
            subprocess.execvp("sudo", ["sudo", "-E", sys.argv[0]] + sys.argv[1:])
    win = Installer()
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
