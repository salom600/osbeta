#!/usr/bin/env python3
#
# nexora-installer — NexoraOS graphical installer
#
# Uses the `archinstall` Python library (in official Arch repos) to actually
# perform the install, but wraps it in a friendly GTK3 wizard.
#
# Flow:
#   1. Welcome screen (requirements check)
#   2. Language + timezone
#   3. Disk selection + partitioning scheme
#   4. User account (username, password, hostname)
#   5. Desktop profile (default: NexoraDE)
#   6. Summary + confirmation
#   7. Install (progress bar + log)
#   8. Reboot prompt
#
# Runs as root via pkexec.

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib
import os
import sys
import subprocess
import threading
import json

