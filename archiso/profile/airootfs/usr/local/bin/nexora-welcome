#!/usr/bin/env python3
#
# nexora-welcome — first-run welcome screen
#
# Presented on first login. Shows:
#   - Welcome banner
#   - "Install NexoraOS to disk" button (launches calamares)
#   - "Open Nexora Store" button
#   - Quick links (docs, support)
#   - "Don't show again" checkbox
#
# Touches $HOME/.config/nexora/.welcomed once dismissed.

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk
import os
import subprocess

CSS = b"""
.nexora-welcome { background-color: #0f2027; color: #e6e6e6; font-family: 'Ubuntu','Noto Sans',sans-serif; }
.nexora-welcome .header { font-size: 24px; font-weight: bold; color: #8be9fd; padding: 18px; }
.nexora-welcome .sub { font-size: 13px; color: #b0b0b0; padding: 0 18px 14px 18px; }
.nexora-welcome .frame { background: rgba(255,255,255,0.04); border: 1px solid rgba(139,233,253,0.18); border-radius: 8px; padding: 14px; margin: 10px; }
.nexora-welcome .btn-primary { background: #8be9fd; color: #0f2027; border-radius: 6px; padding: 12px 22px; font-weight: bold; }
.nexora-welcome .btn-primary:hover { background: #6fc7e0; }
.nexora-welcome .btn-secondary { background: rgba(139,233,253,0.18); color: #e6e6e6; border: 1px solid rgba(139,233,253,0.30); border-radius: 6px; padding: 10px 18px; }
.nexora-welcome .btn-secondary:hover { background: rgba(139,233,253,0.30); }
"""

WELCOME_FLAG = os.path.expanduser("~/.config/nexora/.welcomed")


def run(cmd):
    try:
        subprocess.Popen(cmd, shell=True, start_new_session=True)
    except Exception as e:
        print(f"spawn failed: {e}")


class Welcome(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Welcome to NexoraOS")
        self.set_default_size(640, 480)
        self.set_name("nexora-welcome")
        self.set_position(Gtk.WindowPosition.CENTER)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(outer)

        hdr = Gtk.Label(label="◆ Welcome to NexoraOS 2026.1")
        hdr.get_style_context().add_class("header")
        outer.pack_start(hdr, False, False, 0)

        sub = Gtk.Label(label="Lightweight. Modern. Yours.")
        sub.get_style_context().add_class("sub")
        outer.pack_start(sub, False, False, 0)

        # Action area
        actions = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        actions.set_border_width(10)
        outer.pack_start(actions, True, True, 0)

        # Install button (primary)
        install_btn = Gtk.Button(label="⬇  Install NexoraOS to disk")
        install_btn.get_style_context().add_class("btn-primary")
        install_btn.connect("clicked", lambda *_: run("nexora-installer"))
        actions.pack_start(install_btn, False, False, 0)

        # Store button
        store_btn = Gtk.Button(label="🛍  Open Nexora Store")
        store_btn.get_style_context().add_class("btn-secondary")
        store_btn.connect("clicked", lambda *_: run("nexora-store"))
        actions.pack_start(store_btn, False, False, 0)

        # Tour / settings
        tour_btn = Gtk.Button(label="⚙  Open Settings")
        tour_btn.get_style_context().add_class("btn-secondary")
        tour_btn.connect("clicked", lambda *_: run("nexora-settings"))
        actions.pack_start(tour_btn, False, False, 0)

        # Docs
        docs_btn = Gtk.Button(label="📖  Read the docs")
        docs_btn.get_style_context().add_class("btn-secondary")
        docs_btn.connect("clicked", lambda *_: run("xdg-open https://github.com/salom600/osbeta/wiki"))
        actions.pack_start(docs_btn, False, False, 0)

        # Don't show again
        check_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        check = Gtk.CheckButton(label="Don't show this again")
        check.set_active(True)
        check_row.pack_start(check, False, False, 10)
        check_row.set_halign(Gtk.Align.END)
        outer.pack_start(check_row, False, False, 10)

        close_btn = Gtk.Button(label="Close")
        close_btn.connect("clicked", self.on_close, check)
        close_btn.set_halign(Gtk.Align.END)
        close_btn.set_margin_end(14)
        close_btn.set_margin_bottom(14)
        outer.pack_start(close_btn, False, False, 0)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.show_all()
        self.connect("destroy", Gtk.main_quit)

    def on_close(self, _btn, check):
        if check.get_active():
            os.makedirs(os.path.dirname(WELCOME_FLAG), exist_ok=True)
            with open(WELCOME_FLAG, "w") as f:
                f.write("1\n")
        Gtk.main_quit()


def main():
    win = Welcome()
    Gtk.main()


if __name__ == "__main__":
    main()
