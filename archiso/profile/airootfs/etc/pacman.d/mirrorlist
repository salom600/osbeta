# NexoraOS pacman mirrorlist — uses the official Arch rank-by-speed list.
# At ISO build time archiso injects a fresh mirrorlist, but we ship a sane
# default in case the live environment has no network at boot.

Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.leaseweb.net/archlinux/$repo/os/$arch
Server = https://arch.mirror.far.fi/$repo/os/$arch
Server = https://mirror.cyberbits.eu/archlinux/$repo/os/$arch
Server = https://mirrors.cat.pdx.edu/archlinux/$repo/os/$arch
