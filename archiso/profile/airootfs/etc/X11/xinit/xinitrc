#!/bin/sh
# /etc/X11/xinit/xinitrc — fallback for `startx`
# In NexoraOS the live session is launched by lightdm; this file is for users
# who prefer `startx` from a TTY.

if [ -d /etc/X11/xinit/xinitrc.d ]; then
    for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
        [ -x "$f" ] && . "$f"
    done
    unset f
fi

exec /usr/local/bin/nexora-session
